"""{{ provider }} credentials.
{%- if auth == 'oauth_refresh' %}

**User token** (`bench auth login {{ name }}`, browser sign-in): the access token expires
and the refresh token rotates on every use; `RotatingRefresh` stores the new pair before
the call is retried. Token responses report the granted scopes, so the server can hide
tools the user did not grant.
{%- elif auth == 'client_credentials' %}

**Service account** (client credentials grant): a fresh access token whenever the old
one expires. Token responses report the granted scopes, so the server can hide tools.
{%- elif auth == 'bearer' %}

**Static token** (API key or bot token): never refreshed; a 401 means it was revoked.
The granted scopes are unknown, so every tool stays registered.
{%- else %}

**API token** (HTTP Basic with the account e-mail and an API token): never refreshed;
a 401 means it was revoked. The granted scopes are unknown, so every tool stays
registered.
{%- endif %}
"""
{% if auth == 'oauth_refresh' %}
import httpx2

from bench_core.auth import Credential, LoginSpec, RotatingRefresh, TokenEndpoint, TokenStore
from bench_core.clock import Clock
from bench_core.permissions import Granted

TOKEN_URL = "{{ token_url }}"
AUTHORIZE_URL = "{{ authorize_url }}"

LOGIN = LoginSpec(
    account="{{ name }}",
    authorize_url=AUTHORIZE_URL,
    token_url=TOKEN_URL,
    client_id_var="{{ name | upper }}_CLIENT_ID",
    client_secret_var="{{ name | upper }}_CLIENT_SECRET",
    scopes=(),  # what the sign-in asks for, e.g. the scopes the tools require
)
"""`bench auth login {{ name }}`; set `pkce=False` if the provider rejects PKCE."""


def user_token(
    account: str,
    store: TokenStore,
    *,
    client_id: str,
    client_secret: str | None,
    token_url: str = TOKEN_URL,
    transport: httpx2.AsyncBaseTransport | None = None,
    clock: Clock | None = None,
) -> RotatingRefresh:
    endpoint = TokenEndpoint(
        token_url, client_id=client_id, client_secret=client_secret, transport=transport
    )
    return RotatingRefresh(account, store, endpoint, clock=clock)


async def granted_scopes(credential: Credential) -> Granted:
    """Scopes of the current access token, or None when unknown (keep every tool)."""
    if not isinstance(credential, RotatingRefresh):
        return None
    await credential.authorization()
    tokens = credential.tokens()
    return tokens.scopes if tokens is not None and tokens.scopes else None
{%- elif auth == 'client_credentials' %}
from collections.abc import Iterable

import httpx2

from bench_core.auth import ClientCredentials, Credential, TokenEndpoint
from bench_core.clock import Clock
from bench_core.permissions import Granted

TOKEN_URL = "{{ token_url }}"


def service_account(
    account: str,
    *,
    client_id: str,
    client_secret: str,
    scopes: Iterable[str] = (),
    token_url: str = TOKEN_URL,
    transport: httpx2.AsyncBaseTransport | None = None,
    clock: Clock | None = None,
) -> ClientCredentials:
    endpoint = TokenEndpoint(
        token_url, client_id=client_id, client_secret=client_secret, transport=transport
    )
    return ClientCredentials(account, endpoint, scopes=frozenset(scopes), clock=clock)


async def granted_scopes(credential: Credential) -> Granted:
    """Scopes of the current access token, or None when unknown (keep every tool)."""
    if not isinstance(credential, ClientCredentials):
        return None
    await credential.authorization()
    tokens = credential.tokens()
    return tokens.scopes if tokens is not None and tokens.scopes else None
{%- elif auth == 'bearer' %}
from bench_core.auth import Credential, StaticToken
from bench_core.permissions import Granted


def static_token(account: str, token: str) -> StaticToken:
    return StaticToken(account, token)


async def granted_scopes(credential: Credential) -> Granted:
    """Static tokens do not report their scopes: None keeps every tool registered."""
    return None
{%- else %}
from bench_core.auth import Credential, StaticToken
from bench_core.permissions import Granted


def api_token(account: str, *, email: str, token: str) -> StaticToken:
    return StaticToken.basic(account, email, token)


async def granted_scopes(credential: Credential) -> Granted:
    """API tokens do not report their scopes: None keeps every tool registered."""
    return None
{%- endif %}
