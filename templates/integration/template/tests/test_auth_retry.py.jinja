@pytest.fixture
async def client_for(fake: {{ cls }}Fake, clock: FakeClock) -> AsyncIterator[Any]:
    apis = []

    def make(cred: Credential) -> {{ cls }}Client:
        api = make_api(credential=cred, transport=fake.transport(), clock=clock)
        apis.append(api)
        return {{ cls }}Client(api)

    yield make
    for api in apis:
        await api.aclose()


