def service_credential(
    fake: {{ cls }}Fake, clock: FakeClock, account: str, *, secret: str = CLIENT_SECRET
) -> Credential:
    return service_account(
        account,
        client_id=CLIENT_ID,
        client_secret=secret,
        transport=fake.transport(),
        clock=clock,
    )


def token_requests(fake: {{ cls }}Fake) -> int:
    return len(fake.calls("POST", TOKEN_PATH))


async def test_token_is_fetched_once_and_renewed_after_expiry(
    fake: {{ cls }}Fake, clock: FakeClock, account: str, client_for: Any
) -> None:
    client = client_for(service_credential(fake, clock, account))
    await client.get_item("1001")
    await client.get_item("1002")
    assert token_requests(fake) == 1
    clock.advance(3600)
    await client.get_item("1001")
    assert token_requests(fake) == 2


